# HTTP
PORT=3001
FRONTEND_URL=http://localhost:5173

# Infrastructure (docker compose up -d from the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# Slack app (https://api.slack.com/apps) — OAuth 2.0 scopes: chat:write, incoming_webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Session signing secret (any long random string)
JWT_SECRET=change-me

# Scheduler tuning
WORKER_CONCURRENCY=5
DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_SEND_ATTEMPTS=100
