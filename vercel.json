{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "services": {
    "backend": {
      "framework": "express",
      "buildCommand": "cd backend && npx tsc --noEmit && echo BUILD_OK",
      "functions": "backend/src/**/*.ts",
      "port": 3001
    },
    "frontend": {
      "framework": "vite",
      "buildCommand": "cd frontend && npm run build",
      "functions": "frontend/dist/**",
      "outputDirectory": "dist"
    }
  },
  "bindings": [
    {
      "type": "redis",
      "service": "backend",
      "name": "REDIS_URL"
    },
    {
      "type": "postgresql",
      "service": "backend", 
      "name": "DATABASE_URL"
    },
    {
      "type": "elasticsearch",
      "service": "backend",
      "name": "ELASTICSEARCH_URL"
    }
  ],
  "routes": []
}